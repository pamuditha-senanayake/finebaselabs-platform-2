# Supabase (server-side only; never expose the service role key to the browser)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Hub connector: the outer platform sends this as "Authorization: Bearer <HUB_API_KEY>"
HUB_API_KEY=
# Optional: portal pushes new customer messages to this URL, signed with HUB_WEBHOOK_SECRET (HMAC-SHA256)
HUB_WEBHOOK_URL=
HUB_WEBHOOK_SECRET=
